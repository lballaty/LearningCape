# Names only. Real values are set with:  supabase secrets set --env-file ./.env   (then delete the local .env)
# or per key:                            supabase secrets set LLM_API_KEY=...
# NEVER commit real values. NEVER place any of these in config.js or any client file.
ALLOWED_ORIGIN=https://learn.example.com
LLM_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
ASSISTANT_MAX_PER_HOUR=20
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions by Supabase; do not set them.
